+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+/* open_fw patch 0046: the byte ring returns only the contiguous piece up to its end, so a frame that reaches the wrap
+ * was sent short (one extra small RFCOMM frame per ring cycle once the write position is no longer MTU aligned, e.g.
+ * after a text reply). When more bytes wait behind the wrap, copy both pieces (up to one MTU) into tx_stage and send
+ * that as one frame. The ring bytes are returned at once (a byte buffer allows one checked-out piece at a time);
+ * write_held keeps counting them, so esp_spp_write()'s room check and the congestion watermarks see no change.
+ * No stage memory (allocation failed): the short piece goes out as upstream does. Caller holds spp_lock. */
+static uint8_t *spp_stage_across_wrap_under_lock(spp_slot_t *slot, uint8_t *data, size_t *item_size)
+{
+    size_t first = *item_size;
+    UBaseType_t waiting = 0;
+    if (first >= slot->mtu) {
+        return data;
+    }
+    vRingbufferGetInfo(slot->ringbuf_write, NULL, NULL, NULL, NULL, &waiting);
+    if (waiting == 0) {
+        return data;                      /* everything there is: not a wrap */
+    }
+    if (slot->tx_stage == NULL || slot->tx_stage_cap < slot->mtu) {
+        uint8_t *st = osi_malloc(slot->mtu);
+        if (st == NULL) {
+            return data;
+        }
+        if (slot->tx_stage) {
+            osi_free(slot->tx_stage);
+        }
+        slot->tx_stage = st;
+        slot->tx_stage_cap = slot->mtu;
+    }
+    memcpy(slot->tx_stage, data, first);
+    vRingbufferReturnItem(slot->ringbuf_write, data);
+    size_t second = 0;
+    uint8_t *rest = xRingbufferReceiveUpTo(slot->ringbuf_write, &second, 0, slot->mtu - first);
+    if (rest) {
+        memcpy(slot->tx_stage + first, rest, second);
+        vRingbufferReturnItem(slot->ringbuf_write, rest);
+    } else {
+        second = 0;
+    }
+    *item_size = first + second;
+    slot->write_held = (uint16_t)(first + second);
+    slot->write_staged = true;
+    return slot->tx_stage;
+}
+#endif
