+        } else if (status == BTM_DEV_STATUS_DOWN) {
+            bta_sys_hw_execute_local(BTA_SYS_ERROR_EVT, BTA_SYS_HW_BLUETOOTH); /* open_fw patch 0014 */
+        }
+#endif
     }
 }
 
