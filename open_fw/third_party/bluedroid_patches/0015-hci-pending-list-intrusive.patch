diff --git a/open_fw/third_party/bluedroid/host/bluedroid/hci/hci_layer.c b/open_fw/third_party/bluedroid/host/bluedroid/hci/hci_layer.c
index 571bda0..629f10f 100644
--- a/open_fw/third_party/bluedroid/host/bluedroid/hci/hci_layer.c
+++ b/open_fw/third_party/bluedroid/host/bluedroid/hci/hci_layer.c
@@ -66,7 +66,16 @@
 typedef struct {
     bool timer_is_set;
     osi_alarm_t *command_response_timer;
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0015: commands awaiting their CC/CS are linked through their own pkt_linked_item_t (free once the
+     * command left command_queue) instead of a list_t node. Upstream allocates that node in event_command_ready()
+     * AFTER the command was dequeued and BEFORE it is sent, ignores a failure and sends anyway: the reply then
+     * matches nothing (a futured start-up command blocks BTU forever, a callback command leaks and never completes).
+     * The intrusive list needs no allocation at all. */
+    STAILQ_HEAD(, pkt_linked_item) commands_pending_response;
+#else
     list_t *commands_pending_response;
+#endif
     osi_mutex_t commands_pending_response_lock;
 } command_waiting_response_t;
 
@@ -286,11 +295,15 @@ static int hci_layer_init_env(void)
     // Init Commands waiting response list and timer
     cmd_wait_q = &hci_host_env.cmd_waiting_q;
     cmd_wait_q->timer_is_set = false;
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    STAILQ_INIT(&cmd_wait_q->commands_pending_response); /* open_fw patch 0015 */
+#else
     cmd_wait_q->commands_pending_response = list_new(NULL);
     if (!cmd_wait_q->commands_pending_response) {
         HCI_TRACE_ERROR("%s unable to create list for commands pending response.", __func__);
         return -1;
     }
+#endif
     osi_mutex_new(&cmd_wait_q->commands_pending_response_lock);
     cmd_wait_q->command_response_timer = osi_alarm_new("cmd_rsp_to", command_timed_out, cmd_wait_q, COMMAND_PENDING_TIMEOUT);
     if (!cmd_wait_q->command_response_timer) {
@@ -327,8 +340,19 @@ static void hci_layer_deinit_env(void)
     }
 
     cmd_wait_q = &hci_host_env.cmd_waiting_q;
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0015: the list owns commands that never got a reply (upstream's list_free() leaked them). */
+    while (!STAILQ_EMPTY(&cmd_wait_q->commands_pending_response)) {
+        pkt_linked_item_t *wait_entry = STAILQ_FIRST(&cmd_wait_q->commands_pending_response);
+        hci_cmd_metadata_t *metadata = (hci_cmd_metadata_t *)(wait_entry->data);
+        STAILQ_REMOVE_HEAD(&cmd_wait_q->commands_pending_response, next);
+        hci_cmd_free_cb free_func = metadata->command_free_cb ? metadata->command_free_cb : (hci_cmd_free_cb) osi_free_func;
+        free_func(wait_entry);
+    }
+#else
     list_free(cmd_wait_q->commands_pending_response);
     cmd_wait_q->commands_pending_response = NULL;
+#endif
     osi_mutex_free(&cmd_wait_q->commands_pending_response_lock);
     cmd_wait_q->commands_pending_response_lock = NULL;
     osi_alarm_free(cmd_wait_q->command_response_timer);
@@ -476,7 +500,11 @@ static void event_command_ready(fixed_pkt_queue_t *queue)
     hci_host_env.command_credits--;
     // Move it to the list of commands awaiting response
     osi_mutex_lock(&cmd_wait_q->commands_pending_response_lock, OSI_MUTEX_MAX_TIMEOUT);
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    STAILQ_INSERT_TAIL(&cmd_wait_q->commands_pending_response, wait_entry, next); /* open_fw patch 0015 */
+#else
     list_append(cmd_wait_q->commands_pending_response, wait_entry);
+#endif
     osi_mutex_unlock(&cmd_wait_q->commands_pending_response_lock);
 
     // Send it off
@@ -535,7 +563,11 @@ static void restart_command_waiting_response_timer(command_waiting_response_t *c
         osi_alarm_cancel(cmd_wait_q->command_response_timer);
         cmd_wait_q->timer_is_set = false;
     }
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    if (!STAILQ_EMPTY(&cmd_wait_q->commands_pending_response)) { /* open_fw patch 0015 */
+#else
     if (!list_is_empty(cmd_wait_q->commands_pending_response)) {
+#endif
         osi_alarm_set(cmd_wait_q->command_response_timer, COMMAND_PENDING_TIMEOUT);
         cmd_wait_q->timer_is_set = true;
     }
@@ -557,8 +589,12 @@ static void command_timed_out(void *context)
         return;
     }
 #endif
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    wait_entry = STAILQ_FIRST(&cmd_wait_q->commands_pending_response); /* open_fw patch 0015 */
+#else
     wait_entry = (list_is_empty(cmd_wait_q->commands_pending_response) ?
                   NULL : list_front(cmd_wait_q->commands_pending_response));
+#endif
     if (wait_entry != NULL) {
         hci_cmd_metadata_t *metadata = (hci_cmd_metadata_t *)(wait_entry->data);
         opcode = metadata->opcode;
@@ -801,6 +837,18 @@ static pkt_linked_item_t *get_waiting_command(command_opcode_t opcode)
     command_waiting_response_t *cmd_wait_q = &hci_host_env.cmd_waiting_q;
     osi_mutex_lock(&cmd_wait_q->commands_pending_response_lock, OSI_MUTEX_MAX_TIMEOUT);
 
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0015 */
+    pkt_linked_item_t *wait_entry;
+    STAILQ_FOREACH(wait_entry, &cmd_wait_q->commands_pending_response, next) {
+        hci_cmd_metadata_t *metadata = (hci_cmd_metadata_t *)(wait_entry->data);
+        if (metadata->opcode == opcode) {
+            STAILQ_REMOVE(&cmd_wait_q->commands_pending_response, wait_entry, pkt_linked_item, next);
+            osi_mutex_unlock(&cmd_wait_q->commands_pending_response_lock);
+            return wait_entry;
+        }
+    }
+#else
     for (const list_node_t *node = list_begin(cmd_wait_q->commands_pending_response);
             node != list_end(cmd_wait_q->commands_pending_response);
             node = list_next(node)) {
@@ -814,6 +862,7 @@ static pkt_linked_item_t *get_waiting_command(command_opcode_t opcode)
             }
         }
     }
+#endif
 
     osi_mutex_unlock(&cmd_wait_q->commands_pending_response_lock);
     return NULL;
