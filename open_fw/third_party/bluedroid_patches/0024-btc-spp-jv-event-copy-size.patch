     status = btc_transfer_context(&msg, p_data,
-                                  sizeof(tBTA_JV), NULL, NULL);
+                                  BTC_SPP_JV_EVT_LEN(event), NULL, NULL);
 
     if (status != BT_STATUS_SUCCESS) {
         BTC_TRACE_ERROR("%s btc_transfer_context failed", __func__);
@@ -702,7 +725,7 @@ static void btc_spp_dm_inter_cb(tBTA_JV_EVT event, tBTA_JV *p_data, void *user_d
         msg.pid = BTC_PID_SPP;
