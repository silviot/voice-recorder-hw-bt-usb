+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+/* open_fw patch 0024: bta_jv_act.c hands several events to these callbacks as a pointer to the event's own struct
+ * cast to tBTA_JV * (RFCOMM_START, RFCOMM_CL_INIT, RFCOMM_WRITE, FREE_SCN, DISABLE, DISCOVERY_COMP: stack variables
+ * of that type), while upstream copies sizeof(tBTA_JV) from it into the BTC message: an out-of-bounds stack read on
+ * every esp_spp_write() (found by ASan in make test-bt-host, phone scenario). Copy the member the event carries;
+ * btc_spp_cb_handler() reads only that member. */
+static size_t btc_spp_jv_evt_len(tBTA_JV_EVT event)
+{
+    switch (event) {
+    case BTA_JV_RFCOMM_START_EVT:   return sizeof(tBTA_JV_RFCOMM_START);
+    case BTA_JV_RFCOMM_CL_INIT_EVT: return sizeof(tBTA_JV_RFCOMM_CL_INIT);
+    case BTA_JV_RFCOMM_WRITE_EVT:   return sizeof(tBTA_JV_RFCOMM_WRITE);
+    case BTA_JV_FREE_SCN_EVT:       return sizeof(tBTA_JV_FREE_SCN);
+    case BTA_JV_DISABLE_EVT:        return sizeof(tBTA_JV_STATUS);
+    case BTA_JV_DISCOVERY_COMP_EVT: return sizeof(tBTA_JV_DISCOVERY_COMP);
+    default:                        return sizeof(tBTA_JV);
+    }
+}
+#define BTC_SPP_JV_EVT_LEN(event) btc_spp_jv_evt_len(event)
+#else
+#define BTC_SPP_JV_EVT_LEN(event) sizeof(tBTA_JV)
+#endif
+
 static void *btc_spp_rfcomm_inter_cb(tBTA_JV_EVT event, tBTA_JV *p_data, void *user_data)
 {
