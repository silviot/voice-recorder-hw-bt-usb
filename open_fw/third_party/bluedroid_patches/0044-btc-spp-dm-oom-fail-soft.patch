+ * A static entry per slot serial (one FreeChannel per slot) stands in. */
+static tBTA_JV_FREE_SCN_USER_DATA s_free_scn_ud_fb[MAX_RFC_PORTS + 1];
+
+static tBTA_JV_FREE_SCN_USER_DATA *spp_free_scn_ud_new(const spp_slot_t *slot, tBTA_JV_SERVER_STATUS st)
+{
+    tBTA_JV_FREE_SCN_USER_DATA *ud = osi_malloc(sizeof(tBTA_JV_FREE_SCN_USER_DATA));
+    if (ud == NULL) {
