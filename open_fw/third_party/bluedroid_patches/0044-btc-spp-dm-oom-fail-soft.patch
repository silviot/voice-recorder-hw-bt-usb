+/* open_fw patch 0044: allocation-free fallbacks for the out-of-memory paths (review STEP10 A9 / C7).
+ *
+ * BTA -> BTC hand-offs that must not be lost (a write completion: is_writing would stay set and the TX side of the
+ * connection stall for good; an RX notification: received data would sit in the queue unannounced, and upstream
+ * asserted) are posted by value when btc_transfer_context() cannot allocate: a work item carrying the slot id,
+ * copied into BTC's queue 0 behind the messages already there (the 0018 mechanism), which runs btc_spp_cb_handler()
+ * from a stack message rebuilt from the slot. */
+static bool spp_post_by_value(void (*fn)(void *ctx), uint32_t id)
+{
+    osi_thread_t *t = btc_get_current_thread();
+    return t != NULL && osi_thread_post(t, fn, (void *)(uintptr_t)id, 0, OSI_THREAD_MAX_TIMEOUT);
+}
+
+typedef union {
+    btc_msg_t msg;
+    uint8_t raw[sizeof(btc_msg_t) + sizeof(tBTA_JV)];
+    uint64_t align;               /* arg at +4 of an 8-aligned base, as in btc_transfer_context()'s heap copy */
+} spp_stack_msg_t;
+
+void btc_spp_cb_handler(btc_msg_t *msg);
+
+static void spp_run_stack_msg(uint8_t event, const tBTA_JV *jv)
+{
+    spp_stack_msg_t buf;
+    memset(&buf, 0, sizeof(buf));
+    buf.msg.sig = BTC_SIG_API_CB;
+    buf.msg.pid = BTC_PID_SPP;
+    buf.msg.act = event;
+    memcpy(buf.msg.arg, jv, sizeof(tBTA_JV));
+    btc_spp_cb_handler(&buf.msg);
+}
+
+/* BTC task. */
+static void spp_fb_data_ind_work(void *ctx)
+{
+    tBTA_JV jv;
+    memset(&jv, 0, sizeof(jv));
+    spp_lock();
+    spp_slot_t *slot = is_spp_ready() ? spp_find_slot_by_id((uint32_t)(uintptr_t)ctx) : NULL;
+    if (slot == NULL) {
+        spp_unlock();
+        return;
+    }
+    jv.data_ind.handle = slot->rfc_handle;
+    spp_unlock();
+    spp_run_stack_msg(BTA_JV_RFCOMM_DATA_IND_EVT, &jv);
+}
+
+/* BTC task. */
+static void spp_fb_write_work(void *ctx)
+{
+    tBTA_JV jv;
+    memset(&jv, 0, sizeof(jv));
+    spp_lock();
+    spp_slot_t *slot = is_spp_ready() ? spp_find_slot_by_id((uint32_t)(uintptr_t)ctx) : NULL;
+    if (slot == NULL || !slot->fb_write_set) {
+        spp_unlock();
+        return;
+    }
+    jv.rfc_write = slot->fb_write;
+    slot->fb_write_set = false;
+    spp_unlock();
+    spp_run_stack_msg(BTA_JV_RFCOMM_WRITE_EVT, &jv);
+}
+
+/* BTU task: a write completion's hand-off failed. One write is outstanding per slot (is_writing), so one copy per
+ * slot is enough. */
+static void spp_write_cmpl_by_value(const tBTA_JV_RFCOMM_WRITE *w)
+{
+    bool stored = false;
+    if (!is_spp_ready()) {
+        return;
+    }
+    spp_lock();
+    spp_slot_t *slot = is_spp_ready() ? spp_find_slot_by_id(w->req_id) : NULL;
+    if (slot != NULL) {
+        slot->fb_write = *w;
+        slot->fb_write_set = true;
+        stored = true;
+    }
+    spp_unlock();
+    if (stored && !spp_post_by_value(spp_fb_write_work, w->req_id)) {
+        BTC_TRACE_ERROR("%s write completion lost (BTC gone)", __func__);
+    }
+}
