+        ud = &s_free_scn_ud_fb[slot->serial];
+    }
+    ud->server_status = st;
+    ud->slot_id = slot->id;
+    return ud;
+}
+
+static void spp_free_scn_ud_free(void *ud)
+{
+    const uint8_t *p = (const uint8_t *)ud;
