+     * above promises not to. Skip it then, and hold the store (bt_port/bt_store.h): the app writes nothing over the
+     * card's bond file this session; the next start parses it again. */
+    if (!parsed) {
+        bt_store_hold_nonempty();
+    } else
+#endif
     if (config_save(config, CONFIG_FILE_PATH)) {
