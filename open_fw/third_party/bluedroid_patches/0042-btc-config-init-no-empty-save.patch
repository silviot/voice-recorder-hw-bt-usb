@@ -22,6 +22,9 @@
 #include "stack/bt_types.h"
 #include "nvs.h"
 
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+void bt_store_hold_nonempty(void);   /* bt_port/bt_store.c (patch 0042) */
+#endif
 static char CONFIG_FILE_PATH[NVS_NS_NAME_MAX_SIZE] = "bt_config.conf";
 static const period_ms_t CONFIG_SETTLE_PERIOD_MS = 3000;
 
@@ -91,6 +94,9 @@ bool btc_config_init(void)
     }
 
     config = config_new(CONFIG_FILE_PATH);
