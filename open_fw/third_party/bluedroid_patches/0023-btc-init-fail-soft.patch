diff --git a/open_fw/third_party/bluedroid/common/osal/src/bt_osal_freertos.c b/open_fw/third_party/bluedroid/common/osal/src/bt_osal_freertos.c
index c8ed813..a78b6c9 100644
--- a/open_fw/third_party/bluedroid/common/osal/src/bt_osal_freertos.c
+++ b/open_fw/third_party/bluedroid/common/osal/src/bt_osal_freertos.c
@@ -1376,6 +1376,14 @@ struct bt_osal_funcs_t * bt_osal_freertos_funcs_get(void)
 
 void bt_osal_freertos_funcs_init(void)
 {
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0023: upstream copies the constant table to the heap and asserts when that fails (after
+     * esp_bluedroid_init() has otherwise succeeded). Nothing ever writes through bt_osal_funcs, so use the table in
+     * place: no allocation, nothing to fail. (The heap copy exists for ESP32 flash-cache-off ISR access; our image
+     * reads .rodata from directly mapped flash.) */
+    bt_osal_funcs = (struct bt_osal_funcs_t *)&bt_osal_funcs_ro;
+    return;
+#endif
     bt_osal_funcs = (struct bt_osal_funcs_t *)bt_osal_malloc(sizeof(struct bt_osal_funcs_t));
     if(!bt_osal_funcs) {
         printf("OSAL funcs init failed\n");
@@ -1387,6 +1395,10 @@ void bt_osal_freertos_funcs_init(void)
 
 void bt_osal_freertos_funcs_deinit(void)
 {
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    bt_osal_funcs = NULL; /* open_fw patch 0023: the constant table, not a heap copy */
+    return;
+#endif
     if (bt_osal_funcs) {
         bt_osal_free(bt_osal_funcs);
     }
diff --git a/open_fw/third_party/bluedroid/common/osi/alarm.c b/open_fw/third_party/bluedroid/common/osi/alarm.c
index 805ccdf..8e75983 100644
--- a/open_fw/third_party/bluedroid/common/osi/alarm.c
+++ b/open_fw/third_party/bluedroid/common/osi/alarm.c
@@ -62,8 +62,13 @@ int osi_alarm_create_mux(void)
         OSI_TRACE_WARNING("%s, invalid state %d\n", __func__, alarm_state);
         return -1;
     }
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0023: report the failure (upstream returns 0 and osi_alarm_init() asserts on the NULL mutex) */
+    return osi_mutex_new(&alarm_mutex) == 0 ? 0 : -1;
+#else
     osi_mutex_new(&alarm_mutex);
     return 0;
+#endif
 }
 
 int osi_alarm_delete_mux(void)
@@ -101,6 +106,11 @@ end:
 
 void osi_alarm_deinit(void)
 {
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    if (alarm_mutex == NULL) {
+        return; /* open_fw patch 0023: osi_alarm_create_mux() failed, nothing was initialised */
+    }
+#endif
     assert(alarm_mutex != NULL);
 
     osi_mutex_lock(&alarm_mutex, OSI_MUTEX_MAX_TIMEOUT);
diff --git a/open_fw/third_party/bluedroid/host/bluedroid/btc/core/btc_main.c b/open_fw/third_party/bluedroid/host/bluedroid/btc/core/btc_main.c
index 3852f6f..ebedb48 100644
--- a/open_fw/third_party/bluedroid/host/bluedroid/btc/core/btc_main.c
+++ b/open_fw/third_party/bluedroid/host/bluedroid/btc/core/btc_main.c
@@ -94,6 +94,38 @@ void btc_cleanup_partial_init(void)
 
 static void btc_init_bluetooth(void)
 {
+#if defined(OPENFW_BLUEDROID) && OPENFW_BLUEDROID
+    /* open_fw patch 0023: the alarm mutex and the config are checked, and the config is loaded BEFORE the BTE boot:
+     * after bte_main_boot_entry() the BTU task may already have completed the init future (btc_init_callback), so a
+     * later failure could no longer be reported. Every failure here completes the future with FUTURE_FAIL and leaves
+     * only what esp_bluedroid_init()'s btc_cleanup_partial_init() (non-clean branch) releases. */
+    if (osi_alarm_create_mux() != 0) {
+        future_ready(*btc_main_get_future_p(BTC_MAIN_INIT_FUTURE), FUTURE_FAIL);
+        return;
+    }
+    osi_alarm_init();
+#if (SMP_INCLUDED)
+    if (!btc_config_init()) {   /* cleans up after itself on failure */
+        future_ready(*btc_main_get_future_p(BTC_MAIN_INIT_FUTURE), FUTURE_FAIL);
+        return;
+    }
+#endif
+    s_init_done_sem = xSemaphoreCreateBinary();
+    if ((s_init_done_sem == NULL) || (bte_main_boot_entry(btc_init_callback) != 0)) {
+#if (SMP_INCLUDED)
+        btc_config_clean_up();
+#endif
+        future_ready(*btc_main_get_future_p(BTC_MAIN_INIT_FUTURE), FUTURE_FAIL);
+        return;
+    }
+#if (SMP_INCLUDED)
+#if (BLE_INCLUDED == TRUE)
+    //load the ble local key which has been stored in the flash
+    btc_dm_load_ble_local_keys();
+    bta_dm_co_security_param_init();
+#endif  ///BLE_INCLUDED == TRUE
+#endif /* #if (SMP_INCLUDED) */
+#else
     osi_alarm_create_mux();
     osi_alarm_init();
     s_init_done_sem = xSemaphoreCreateBinary();
@@ -110,6 +142,7 @@ static void btc_init_bluetooth(void)
     bta_dm_co_security_param_init();
 #endif  ///BLE_INCLUDED == TRUE
 #endif /* #if (SMP_INCLUDED) */
+#endif /* open_fw patch 0023 */
 #if BTA_DYNAMIC_MEMORY
     deinit_semaphore = xSemaphoreCreateBinary();
 #endif /* #if BTA_DYNAMIC_MEMORY */
