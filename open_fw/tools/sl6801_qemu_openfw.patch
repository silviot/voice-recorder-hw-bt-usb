+static uint64_t sl6801_uart0_read(void *opaque, hwaddr offset, unsigned size)
+{
+    SL6801MachineState *s = opaque;
+
+    if (offset == 0x08) {
+        return 0x10; /* 16 TX FIFO slots free */
+    }
+    return s->uart0_reg[(offset >> 2) & 15];
+}
+
+static void sl6801_uart0_write(void *opaque, hwaddr offset,
+                               uint64_t value, unsigned size)
+{
+    SL6801MachineState *s = opaque;
+
+    if (offset == 0x00) {
+        char c = (char)(value & 0xff);
+        fputc(c, stderr);
+        if (c == '\n') {
+            fflush(stderr);
+        }
+        return;
+    }
+    s->uart0_reg[(offset >> 2) & 15] = (uint32_t)value;
+}
