# Classic-only, host-only Bluedroid for SL6801 (ROM RW-BT controller is external to this stack)
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_A2DP_ENABLE=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_SSP_ENABLED=y
CONFIG_BT_BLE_ENABLED=n
CONFIG_BT_GATTS_ENABLE=n
CONFIG_BT_GATTC_ENABLE=n
CONFIG_BT_HFP_ENABLE=n
CONFIG_BT_HID_ENABLED=n
CONFIG_BT_BLE_SMP_ENABLE=n
CONFIG_BT_BLE_BLUFI_ENABLE=n
CONFIG_BT_BLUEDROID_MEM_DEBUG=n
CONFIG_BT_BLUEDROID_PINNED_TO_CORE_0=y
# Host-only: the ROM controller does not implement Espressif vendor HCI commands
CONFIG_BT_BLUEDROID_ESP_COEX_VSC=n
CONFIG_BT_ENC_KEY_SIZE_CTRL_NONE=y
CONFIG_BT_CLASSIC_ENABLE_ENC_KEY_SIZE_CTRL_VSC=n
CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED=n
CONFIG_BT_OSAL_ENABLED=y
CONFIG_BT_OSAL_USE_ESP_TIMER=n
# Footprint tuning: one headphone OR one phone at a time (modes are mutually exclusive), few bonds
CONFIG_BT_ACL_CONNECTIONS=2
CONFIG_BT_SMP_MAX_BONDS=4
