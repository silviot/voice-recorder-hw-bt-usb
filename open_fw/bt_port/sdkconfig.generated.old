CONFIG_SOC_BT_SUPPORTED=y
CONFIG_SOC_BT_CLASSIC_SUPPORTED=y
CONFIG_IDF_TARGET_ESP32=y
CONFIG_IDF_TARGET="esp32"
CONFIG_FREERTOS_UNICORE=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=y

#
# Bluetooth
#
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
# CONFIG_BT_NIMBLE_ENABLED is not set
# CONFIG_BT_CONTROLLER_ONLY is not set
# CONFIG_BT_CONTROLLER_ENABLED is not set
CONFIG_BT_CONTROLLER_DISABLED=y

#
# Common Options
#
CONFIG_BT_BTC_TASK_STACK_SIZE=3072
CONFIG_BT_ALARM_MAX_NUM=50

#
# OSAL (OS abstraction layer)
#
CONFIG_BT_OSAL_ENABLED=y
# CONFIG_BT_OSAL_USE_ESP_TIMER is not set
# end of OSAL (OS abstraction layer)

CONFIG_BT_SMP_CRYPTO_STACK_TINYCRYPT=y
# CONFIG_BT_SMP_CRYPTO_STACK_MBEDTLS is not set

#
# BT Logs
#

#
# Log Sources
#
# end of Log Sources

# CONFIG_BT_LOG_CRITICAL_ONLY is not set
# CONFIG_BLE_LOG_ENABLED is not set

#
# Legacy SPI Log Output (Deprecated - use BT Log Async Output instead)
#
# CONFIG_BT_BLE_LOG_SPI_OUT_ENABLED is not set
# end of Legacy SPI Log Output (Deprecated - use BT Log Async Output instead)
# end of BT Logs

# CONFIG_BT_LE_USED_MEM_STATISTICS_ENABLED is not set
# end of Common Options

#
# Bluedroid Options
#
CONFIG_BT_BLUEDROID_PINNED_TO_CORE=0
CONFIG_BT_BTU_TASK_STACK_SIZE=4352
# CONFIG_BT_BLUEDROID_ESP_COEX_VSC is not set
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_CLASSIC_MAX_RECONNECT_ON_COLLISION=5
# CONFIG_BT_CLASSIC_ENABLE_POWER_CTRL_VSC is not set
# CONFIG_BT_ENC_KEY_SIZE_CTRL_STD is not set
# CONFIG_BT_ENC_KEY_SIZE_CTRL_VSC is not set
CONFIG_BT_ENC_KEY_SIZE_CTRL_NONE=y
# CONFIG_BT_CLASSIC_ENABLE_ENC_KEY_SIZE_CTRL_VSC is not set
# CONFIG_BT_CLASSIC_BQB_ENABLED is not set
CONFIG_BT_A2DP_ENABLE=y
# CONFIG_BT_A2DP_USE_EXTERNAL_CODEC is not set
CONFIG_BT_A2DP_SINK_MAX_CONN=1
# CONFIG_BT_A2DP_AUDIO_STATS is not set
CONFIG_BT_AVRCP_ENABLED=y

#
# AVRCP Features
#
# CONFIG_BT_AVRCP_CT_COVER_ART_ENABLED is not set
# end of AVRCP Features

CONFIG_BT_SPP_ENABLED=y
# CONFIG_BT_PAN_ENABLED is not set
# CONFIG_BT_L2CAP_ENABLED is not set
# CONFIG_BT_SDP_COMMON_ENABLED is not set
CONFIG_BT_SDP_PAD_LEN=300
CONFIG_BT_SDP_ATTR_LEN=300
# CONFIG_BT_OPP_ENABLED is not set
# CONFIG_BT_HFP_ENABLE is not set
# CONFIG_BT_HID_ENABLED is not set
# CONFIG_BT_PBAC_ENABLED is not set

